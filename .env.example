# GROQ API Key — get yours at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Model to use (do not change unless you know what you're doing)
GROQ_MODEL=llama-3.3-70b-versatile

# Max tokens per agent response (8192 recommended for large projects)
MAX_TOKENS=4096

# Temperature for model creativity (0.0 = deterministic, 1.0 = creative)
TEMPERATURE=0.7

# ── future.md Features ────────────────────────────────────────────────────────

# CHUNKED_MODE: Set to "true" to make Hulk write one file at a time.
# Recommended for full-stack projects with 10+ files.
CHUNKED_MODE=true

# CONTEXT_TOKEN_LIMIT: Max tokens allowed in the shared context window.
# Increase this if your Groq plan supports a larger context.
# Default: 90000 (leaves ~38k headroom in the 128k LLaMA window)
CONTEXT_TOKEN_LIMIT=30000

# VERCEL_TOKEN: Required for Vision's auto-deployment step.
# Get yours at https://vercel.com/account/tokens
VERCEL_TOKEN=your_vercel_token_here

# DEBUG: Set to "true" to print full error stack traces
DEBUG=false
